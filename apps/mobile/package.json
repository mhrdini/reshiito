{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "expo start --clear",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "test": "clear && jest --verbose --watchAll",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@config/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~54.0.13",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-image": "~3.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.8",
    "expo-manifests": "~1.0.8",
    "expo-media-library": "~18.2.0",
    "expo-router": "~6.0.11",
    "expo-status-bar": "~3.0.8",
    "ky": "^1.11.0",
    "nativewind": "latest",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-dotenv": "^3.4.11",
    "react-native-reanimated": "~4.1.2",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.1",
    "tailwindcss-animate": "1.0.7",
    "types": "workspace:*",
    "ui": "workspace:*",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@config/prettier": "workspace:*",
    "@config/eslint": "workspace:*",
    "@config/typescript": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.13",
    "eslint": "^9.25.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.12",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "expo-router": {
    "appDir": "src/app"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|native-base|react-native-svg|ky))"
    ],
    "moduleNameMapper": {
      "^@/mocks/(.*)$": "<rootDir>/__mocks__/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^ui/(.*)$": "<rootDir>/../../packages/ui/src/$1",
      "^types/(.*)$": "<rootDir>/../../packages/types/src/$1",
      "^@config/shared/(.*)$": "<rootDir>/../../config/shared/$1",
      "^@env$": "<rootDir>/env.d.ts"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ]
  }
}
