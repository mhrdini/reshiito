{
  "name": "reshiito",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "commit": "git-cz",
    "setup:python": "node scripts/setupPython.js",
    "setup:python:unix": "bash -c 'source $(bash scripts/setup_python.sh | tail -n 1)'",
    "setup:python:windows": "powershell -ExecutionPolicy ByPass -File scripts\\setup_python.ps1 | ForEach-Object { & $_ }",
    "generate:types": "node scripts/generateTypes.js",
    "generate:types:unix": "bash scripts/generate_types.sh",
    "generate:types:windows": "powershell -ExecutionPolicy ByPass -File scripts\\generate_types.ps1",
    "install:packages": "node scripts/installPackages.js",
    "install:packages:unix": "bash scripts/install_packages.sh",
    "install:packages:windows": "powershell -ExecutionPolicy ByPass -File scripts\\install_packages.ps1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@config/eslint": "workspace:*",
    "@config/prettier": "workspace:*",
    "@config/typescript": "workspace:*",
    "commitizen": "^4.3.1",
    "eslint": "^9.34.0",
    "inquirer": "9",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "validate-branch-name": "^1.3.2"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=18"
  },
  "validate-branch-name": {
    "pattern": "^(main){1}$|^(feat|fix|hotfix|release|chore)/.+$",
    "errorMsg": "Invalid branch name \n Ex. [master, develop, feature/feature-info, fix/112-fix-info, hotfix/112-hotfix-info, release/1.0.0, chores/chores-info]"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx,css,html}": [
      "prettier --single-quote --write",
      "eslint --fix --config ./config/eslint/base.js"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "prettier": "@config/prettier"
}
